{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "custom",
      "format": "Azure's Environment"
    },
    {
      "type": "command",
      "key": "fastfetch",
      "text": "fastfetch --version | grep -Eom1 '[0-9]+(\\.[0-9A-Za-z-]+)+'"
    }
  ]
}